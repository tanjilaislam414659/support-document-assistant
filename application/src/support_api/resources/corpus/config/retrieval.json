{
  "schema_version": 1,
  "spec_id": "bm25-keyword-v1",
  "method": "bm25",
  "searchable_fields": [
    "text"
  ],
  "tokenizer": {
    "normalization": "NFKC_then_casefold",
    "pattern": "(?u)(?:--?)?\\w+(?:[.-]\\w+)*",
    "stemming": false,
    "stop_words": [],
    "query_term_frequency": "binary_unique_sorted"
  },
  "bm25": {
    "k1": 1.2,
    "b": 0.75,
    "idf": "ln(1 + (N - df + 0.5) / (df + 0.5))",
    "tf_factor": "tf * (k1 + 1) / (tf + k1 * (1 - b + b * dl / avgdl))",
    "document_length": "all token occurrences in text",
    "average_length": "sum(dl)/N, including zero-token chunks"
  },
  "ranking": {
    "positive_scores_only": true,
    "tie_break": "score descending, then chunk_id ascending; exact float scores, no pre-sort rounding",
    "default_top_k": 5,
    "max_top_k": 40,
    "pad_results": false
  },
  "query": {
    "max_characters": 4096,
    "empty_or_no_tokens": "return []",
    "invalid_controls": "reject C0 controls except TAB, LF, CR; reject surrogate code points"
  },
