  "components": {
    "schemas": {
      "DraftContent": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "default": "Support issue"
          },
          "issue": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Issue"
          },
          "environment": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 20,
            "title": "Environment"
          },
          "selected_sources": {
            "items": {
              "$ref": "#/components/schemas/SourceSelection"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Selected Sources"
          },
          "missing_information": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 10,
            "title": "Missing Information"
          },
          "human_notes": {
            "type": "string",
            "maxLength": 4000,
            "title": "Human Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "issue"
        ],
        "title": "DraftContent"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ExperimentalResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "application_version": {
            "type": "string",
            "title": "Application Version"
          },
          "experimental": {
            "type": "boolean",
            "const": true,
            "title": "Experimental",
            "default": true
          },
          "unverified": {
            "type": "boolean",
            "const": true,
            "title": "Unverified",
            "default": true
          },
          "model_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JsonValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "application_validation_outcome": {
            "type": "string",
            "enum": [
              "validated_answer",
              "validated_insufficient_evidence",
              "generation_validation_error"
            ],
            "title": "Application Validation Outcome"
          },
